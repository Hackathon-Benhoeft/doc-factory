# Copie para .env e ajuste. Tudo tem valor padrão que roda local com SQLite.

# --- Banco e storage (dev = SQLite + disco; docker-compose = Postgres + MinIO)
DATABASE_URL=sqlite:///./data/docfactory.db
STORAGE_BACKEND=local
DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://docfactory:docfactory@localhost:5432/docfactory
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# --- Ambiente: em "producao" a API se recusa a subir sem login, sem segredos ou com CORS aberto
AMBIENTE=desenvolvimento

# --- Segurança
# erros de senha seguidos antes de bloquear o login, e por quantos minutos
LOGIN_MAX_TENTATIVAS=5
# cadastro aberto na tela de login (qualquer pessoa vira analista). Em produção: false
CADASTRO_ABERTO=true
LOGIN_BLOQUEIO_MIN=5
# página maior que isso (megapixels) é renderizada com DPI menor, para não estourar a memória
MAX_MEGAPIXELS_PAGINA=60
# API_KEY=troque-isto
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4200,http://127.0.0.1:4200

# Login com perfis (analista < revisor < admin). false = API aberta (demo).
AUTH_ATIVO=false
# JWT_SEGREDO=gere-um-valor-longo-e-aleatorio
# ADMIN_USUARIO=admin
# ADMIN_SENHA=troque-isto          # cria o admin no primeiro start, se não houver usuários

# --- Resumo de cada documento (com modelo configurado usa o modelo; sem, resumo simples)
RESUMO_ATIVO=true
RESUMO_CHARS_POR_PARTE=6000

# --- Pipeline
DPI_OCR=300
OCR_LANG=por
LIMIAR_REVISAO=0.70
LIMIAR_LLM=0.75
LLM_SEMPRE=false

# --- Anonimização (CPF/CNPJ/RG/e-mail/telefone sempre; nomes e endereços configuráveis)
ANONIMIZAR_NOMES=true
ANONIMIZAR_ENDERECOS=true
NER_MODELO=pt_core_news_md
# segredo da impressão digital do CPF (dossiê do trabalhador). Em produção defina um valor longo e aleatório;
# sem ele, um segredo é gerado e guardado no banco.
# CPF_SEGREDO=troque-por-um-valor-longo-e-aleatorio

# --- Validade e painéis
# vence em até N dias = "vencendo" (prioridade alta)
VALIDADE_ALERTA_DIAS=30
# fuso de "hoje" e "esta semana" nos painéis (Brasília = -3)
FUSO_HORAS=-3

# --- Demo num processo só (API + worker na mesma máquina)
WORKER_INLINE=true

# --- Modelo: escolha UM bloco. Confirmem os nomes de modelo atuais na doc de cada provedor.
LLM_PROVIDER=nenhum

# Gemini (barato, ótimo com imagem de documento)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=...

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-...

# DeepSeek (só texto — recebe o OCR mascarado)
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=...

# Ollama local (nada sai da máquina): ollama pull qwen2.5vl:7b
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5vl:7b

# --- Uso de IA visível (F0) e fraude (F1)
# custo médio de UMA chamada ao modelo, só para estimar o custo do lote na tela (0 = não mostrar R$)
LLM_CUSTO_POR_CHAMADA_BRL=0.0
# documento com risco "atencao" (ex.: conteúdo repetido) também vai para a fila de revisão
FRAUDE_ATENCAO_REVISAO=true

# --- Exigências por função (F3): a função lida no ASO/CTPS acrescenta NRs ao checklist (tabela em tipos.py)
FUNCAO_EXIGENCIAS_ATIVO=true

# --- Pré-revisão (F2): documento pendente ganha explicação + sugestão (só sugere; quem decide é o revisor)
PRE_REVISAO_ATIVA=true
# teto de chamadas de IA de pré-revisão por lote (passou disso, a sugestão sai por regras)
PRE_REVISAO_MAX_POR_LOTE=50

# --- Alertas de vencimento (F6): e-mail (SMTP) e WhatsApp (Evolution API). O agendador é o laço do worker.
# liga o envio automático 1x por dia (a partir de ALERTAS_HORA_EXECUCAO, hora local de FUSO_HORAS)
ALERTAS_ATIVO=false
# simulado = não envia nada, só registra no histórico e no log | real = envia de verdade
ALERTAS_MODO=simulado
# faixas de aviso em dias antes do vencimento (+ "vencido"); cada documento avisa uma vez por faixa
ALERTAS_FAIXAS_DIAS=30,15,7,1
ALERTAS_HORA_EXECUCAO=8
# base dos links nas mensagens
ALERTAS_URL_PUBLICA=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
SMTP_TLS=true
# WhatsApp: instância já conectada da Evolution API v2 (POST /message/sendText/{instancia})
EVOLUTION_URL=
EVOLUTION_INSTANCIA=
EVOLUTION_APIKEY=

# --- Portal do fornecedor (F7): link privado sem login; o fornecedor envia e vê o veredito na hora
PORTAL_ATIVO=true
# o link mandado ao fornecedor é {PORTAL_URL_BASE}/portal/{token} (o token aparece só uma vez, na criação)
PORTAL_URL_BASE=http://localhost:5173
PORTAL_MAX_UPLOAD_MB=20
PORTAL_MAX_PAGINAS=30
# envios por hora por link e IP (acima disso: 429)
PORTAL_MAX_ENVIOS_POR_HORA=30
# validade padrão do convite, em dias
PORTAL_VALIDADE_DIAS=14
# prioridade do lote do portal no worker (3 = alta: veredito rápido)
PORTAL_PRIORIDADE=3

# --- Vários documentos numa imagem (F8): recorta cada folha detectada (por contornos) numa página própria
MULTIDOC_ATIVO=true
# também em páginas-imagem de PDF escaneado (PDF com texto nativo nunca é alterado)
MULTIDOC_PDF=true
# cada folha precisa ocupar ao menos esta % da página
MULTIDOC_AREA_MIN_PCT=8
# mais regiões que isso = suspeito, não divide
MULTIDOC_MAX_RECORTES=6
MULTIDOC_DPI_DETECCAO=100
MULTIDOC_DPI_RECORTE=300
# arquivo maior que isso (MB) não passa pela detecção
MULTIDOC_MAX_MB=100
